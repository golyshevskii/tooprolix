<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Third-party licenses</title></head>
<body>
<h1>Third-party licenses</h1>
<p>Generated by cargo-about 0.9.1 from Cargo.lock. Do not edit.</p>
{{#each licenses}}
<section>
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}}{{#unless (eq crate.name "tooprolix")}} {{crate.version}}{{/unless}}{{#if crate.repository}} — <a href="{{crate.repository}}">source</a>{{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
